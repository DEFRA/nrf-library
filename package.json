{
  "name": "@defra/nrf-library",
  "version": "1.9.0",
  "description": "Shared library for NRF projects.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "TZ=UTC vitest run --coverage",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "lint": "npm run lint:js",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "git:pre-commit-hook": "npm audit --audit-level=high && npm run format:check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/nrf-library.git"
  },
  "bugs": {
    "url": "https://github.com/DEFRA/nrf-library/issues"
  },
  "homepage": "https://github.com/DEFRA/nrf-library#readme",
  "license": "OGL-UK-3.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "neostandard": "^0.11.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}
